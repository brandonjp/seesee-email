# SeeSee Configuration
# Copy to .env and adjust values for your deployment.
# All variables use the SEESEE_ prefix.

# =============================================================================
# Server
# =============================================================================
SEESEE_PORT=8080
# On a real deployment set this to the https:// URL. It builds the integration
# ENV vars, and it is the fallback that marks session/flash cookies Secure when
# the reverse proxy's X-Forwarded-Proto is not trusted.
SEESEE_BASE_URL=http://localhost:8080

# =============================================================================
# Auth
# =============================================================================
SEESEE_ADMIN_USERNAME=admin
SEESEE_ADMIN_PASSWORD=           # Required — no default, must be set

# =============================================================================
# Database
# =============================================================================
SEESEE_DB_PATH=/data/seesee.db

# =============================================================================
# SMTP Ingest
# =============================================================================
SEESEE_SMTP_ENABLED=true
SEESEE_SMTP_PORT=2525

# =============================================================================
# Retention
# =============================================================================
SEESEE_RETENTION_MAX_COUNT=1000             # Max emails per app (most restrictive of app/global wins)
SEESEE_RETENTION_MAX_AGE_DAYS=90            # Delete emails older than N days (most restrictive wins)
SEESEE_RETENTION_MAX_STORAGE_MB=500         # Global storage cap in MB (oldest deleted first)
SEESEE_RETENTION_CLEANUP_INTERVAL_MINUTES=60  # How often the cleanup scheduler runs (minutes)
SEESEE_RETENTION_DEGRADE_TO_TEXT_DAYS=0        # Strip HTML body after N days, keep text (0 = never)
SEESEE_RETENTION_DEGRADE_TO_PREVIEW_DAYS=0     # Strip text body after N days, keep preview only (0 = never)

# =============================================================================
# Session
# =============================================================================
SEESEE_SECRET_KEY=                 # Secret key for signing session cookies (falls back to SEESEE_ADMIN_PASSWORD)
SEESEE_SESSION_MAX_AGE_DAYS=7      # Session cookie expiry in days

# =============================================================================
# UI
# =============================================================================
SEESEE_THEME=system               # "light", "dark", or "system"

# Display timezone for admin views. IANA timezone string.
# Does NOT affect storage (always UTC) or API responses (always UTC ISO 8601).
SEESEE_DISPLAY_TIMEZONE=UTC       # e.g. "America/Chicago", "Europe/London"

# =============================================================================
# Webhook Secrets (optional — skip signature verification if empty)
# =============================================================================
SEESEE_WEBHOOK_SECRET_RESEND=      # Svix signing secret from Resend dashboard (starts with whsec_)
SEESEE_WEBHOOK_SECRET_SENDGRID=    # Shared secret for SendGrid webhook token verification

# =============================================================================
# Logging
# =============================================================================
SEESEE_LOG_LEVEL=info
